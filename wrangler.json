{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "work-portfolio",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "ROOM_SNAPSHOTS",
      "bucket_name": "work-portfolio-snapshots"
    }
  ],
  "upload_source_maps": true,
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",
    "TURNSTILE_SITE_KEY": ""
  }
}
